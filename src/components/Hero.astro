---
---

<div id='hero-stage'></div>
<div id='ui-container'></div>

<style is:global>
  body {
    margin: 0;
    overflow: hidden;
    background-color: #050505;
    font-family: 'Inter', sans-serif;
  }
  canvas {
    display: block;
    width: 100vw;
    height: 100vh;
  }
  #ui-container {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 10;
  }
</style>

<script>
  import * as THREE from 'three';
  import GUI from 'lil-gui';

  type ShapeType = 'Hexagon' | 'Square';

  interface GridParams {
    shapeType: ShapeType;
    gridSize: number;
    radius: number;
    gap: number;
    offsetRows: boolean;
    cameraZ: number;
    cameraFov: number;
    lightIntensity: number;
    floorGlow: number;
    baseColor: string;
    neonColor: string;
    secondaryColor: string;
    influenceRadius: number;
    maxExtrusion: number;
    waveIntensity: number;
    springStrength: number;
    autoColor: boolean;
    roughness: number;
    metalness: number;
    clearcoat: number;
    clearcoatRoughness: number;
  }

  const stage = document.getElementById('hero-stage');
  const uiContainer = document.getElementById('ui-container');

  if (!stage || !uiContainer) {
    throw new Error('Hero stage or UI container is missing');
  }

  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x050505, 0.015);

  const camera = new THREE.PerspectiveCamera(
    25,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
  );
  camera.position.set(0, 0, 100);
  camera.lookAt(0, 0, 0);

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(window.innerWidth, window.innerHeight, false);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  stage.appendChild(renderer.domElement);

  scene.add(new THREE.AmbientLight(0xffffff, 0.2));

  const floorMaterial = new THREE.MeshStandardMaterial({
    color: 0x00ffff,
    emissive: 0x00ffff,
    emissiveIntensity: 0.5,
    roughness: 0.8
  });
  const floor = new THREE.Mesh(new THREE.PlaneGeometry(200, 200), floorMaterial);
  floor.position.z = -2;
  scene.add(floor);

  const neonLight = new THREE.PointLight(0x00ffff, 8, 50);
  neonLight.position.z = -1;
  scene.add(neonLight);

  const neonLight2 = new THREE.PointLight(0xff00ff, 6, 45);
  neonLight2.position.z = -1;
  scene.add(neonLight2);

  const params: GridParams = {
    shapeType: 'Hexagon',
    gridSize: 40,
    radius: 1.5,
    gap: 0.138,
    offsetRows: true,
    cameraZ: 100,
    cameraFov: 25,
    lightIntensity: 8.0,
    floorGlow: 0.5,
    baseColor: '#2a2a2a',
    neonColor: '#ffffff',
    secondaryColor: '#5900ff',
    influenceRadius: 10,
    maxExtrusion: 6,
    waveIntensity: 0.3,
    springStrength: 0.05,
    autoColor: false,
    roughness: 0.15,
    metalness: 0.8,
    clearcoat: 1.0,
    clearcoatRoughness: 0.1
  };

  const hexMaterial = new THREE.MeshPhysicalMaterial({
    color: params.baseColor,
    roughness: params.roughness,
    metalness: params.metalness,
    clearcoat: params.clearcoat,
    clearcoatRoughness: params.clearcoatRoughness,
    flatShading: true
  });

  let hexagons: THREE.Mesh[] = [];
  let hexGeometry: THREE.BufferGeometry | undefined;

  function buildGrid(): void {
    hexagons.forEach(mesh => scene.remove(mesh));
    if (hexGeometry) hexGeometry.dispose();
    hexagons = [];

    const useHexagon = params.shapeType === 'Hexagon';
    const geomRadius = params.radius * 1.02;
    const squareSize = params.radius * 1.8;

    let geometry: THREE.BufferGeometry;
    if (useHexagon) {
      const cylinder = new THREE.CylinderGeometry(geomRadius, geomRadius, 0.5, 6);
      cylinder.rotateX(Math.PI / 2);
      geometry = cylinder;
    } else {
      geometry = new THREE.BoxGeometry(
        squareSize * 1.02,
        squareSize * 1.02,
        0.5
      );
    }
    hexGeometry = geometry;

    const stepX = useHexagon
      ? Math.sqrt(3) * params.radius + params.gap
      : squareSize + params.gap;
    const stepY = useHexagon
      ? 1.5 * params.radius + (params.gap * Math.sqrt(3)) / 2
      : squareSize + params.gap;

    const startX = -((params.gridSize - 1) * stepX) / 2;
    const startY = -((params.gridSize - 1) * stepY) / 2;

    for (let row = 0; row < params.gridSize; row++) {
      for (let column = 0; column < params.gridSize; column++) {
        const mesh = new THREE.Mesh(geometry, hexMaterial);

        let x = startX + column * stepX;
        const y = startY + row * stepY;

        if (params.offsetRows && row % 2 !== 0) {
          x += stepX / 2;
        }

        mesh.position.set(x, y, 0);
        mesh.rotation.z = 0;
        mesh.userData = { originalZ: 0, targetZ: 0, velocityZ: 0 };

        scene.add(mesh);
        hexagons.push(mesh);
      }
    }
  }

  const gui = new GUI({ title: 'Background Settings', container: uiContainer });

  const gridFolder = gui.addFolder('Grid');
  gridFolder
    .add(params, 'shapeType', ['Hexagon', 'Square'])
    .name('Shape Type')
    .onChange(buildGrid);
  gridFolder
    .add(params, 'gridSize', 10, 80, 1)
    .name('Grid Size')
    .onChange(buildGrid);
  gridFolder
    .add(params, 'radius', 0.5, 3)
    .name('Shape Size')
    .onChange(buildGrid);
  gridFolder
    .add(params, 'gap', 0, 2)
    .name('Gap Size')
    .onChange(buildGrid);
  gridFolder.add(params, 'offsetRows').name('Offset Rows').onChange(buildGrid);

  const sceneFolder = gui.addFolder('Scene & Interaction');
  sceneFolder
    .add(params, 'cameraZ', 10, 300)
    .name('Camera Z')
    .onChange((z: number) => {
      camera.position.z = z;
    });
  sceneFolder
    .add(params, 'cameraFov', 5, 100)
    .name('Camera FOV')
    .onChange((fov: number) => {
      camera.fov = fov;
      camera.updateProjectionMatrix();
    });
  sceneFolder.add(params, 'influenceRadius', 1, 30).name('Cursor Radius');
  sceneFolder.add(params, 'maxExtrusion', 0, 15).name('Extrusion Height');
  sceneFolder
    .add(params, 'lightIntensity', 0, 20)
    .name('Light Intensity')
    .onChange((v: number) => {
      neonLight.intensity = v;
      neonLight2.intensity = v * 0.75;
    });
  sceneFolder
    .add(params, 'floorGlow', 0, 3)
    .name('Floor Glow')
    .onChange((v: number) => {
      floorMaterial.emissiveIntensity = v;
    });
  sceneFolder.add(params, 'waveIntensity', 0, 2).name('Wave Intensity');
  sceneFolder.add(params, 'springStrength', 0.01, 0.2).name('Spring Speed');

  const colorFolder = gui.addFolder('Colors');
  colorFolder
    .addColor(params, 'baseColor')
    .name('Base Color')
    .onChange((c: string) => {
      hexMaterial.color.set(c);
    });
  colorFolder
    .addColor(params, 'neonColor')
    .name('Neon Color')
    .onChange((c: string) => {
      if (!params.autoColor) {
        neonLight.color.set(c);
        floorMaterial.color.set(c);
        floorMaterial.emissive.set(c);
      }
    });
  colorFolder
    .addColor(params, 'secondaryColor')
    .name('Secondary Color')
    .onChange((c: string) => {
      if (!params.autoColor) neonLight2.color.set(c);
    });
  colorFolder.add(params, 'autoColor').name('Auto-Rainbow');

  const matFolder = gui.addFolder('Material & Reflections');
  matFolder
    .add(params, 'roughness', 0, 1)
    .name('Roughness')
    .onChange((v: number) => {
      hexMaterial.roughness = v;
    });
  matFolder
    .add(params, 'metalness', 0, 1)
    .name('Metalness')
    .onChange((v: number) => {
      hexMaterial.metalness = v;
    });
  matFolder
    .add(params, 'clearcoat', 0, 1)
    .name('Clearcoat')
    .onChange((v: number) => {
      hexMaterial.clearcoat = v;
    });
  matFolder
    .add(params, 'clearcoatRoughness', 0, 1)
    .name('Coat Roughness')
    .onChange((v: number) => {
      hexMaterial.clearcoatRoughness = v;
    });

  gui.close();

  buildGrid();

  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2(-1000, -1000);
  const mouseWorldPos = new THREE.Vector3(-1000, -1000, 0);
  const intersectionPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);

  function updateMousePos(clientX: number, clientY: number): void {
    mouse.x = (clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(clientY / window.innerHeight) * 2 + 1;

    raycaster.setFromCamera(mouse, camera);
    raycaster.ray.intersectPlane(intersectionPlane, mouseWorldPos);
  }

  window.addEventListener('mousemove', event => {
    updateMousePos(event.clientX, event.clientY);
  });

  window.addEventListener(
    'touchmove',
    event => {
      if (event.touches.length > 0) {
        updateMousePos(event.touches[0].clientX, event.touches[0].clientY);
      }
    },
    { passive: true }
  );

  const clock = new THREE.Clock();

  function animate(): void {
    requestAnimationFrame(animate);
    const time = clock.getElapsedTime();

    neonLight.position.x +=
      (mouseWorldPos.x - neonLight.position.x) * 0.1;
    neonLight.position.y +=
      (mouseWorldPos.y - neonLight.position.y) * 0.1;

    neonLight2.position.x = mouseWorldPos.x + Math.sin(time * 2) * 5;
    neonLight2.position.y = mouseWorldPos.y + Math.cos(time * 2) * 5;

    for (let i = 0; i < hexagons.length; i++) {
      const tile = hexagons[i];

      const dx = tile.position.x - mouseWorldPos.x;
      const dy = tile.position.y - mouseWorldPos.y;
      const distance = Math.sqrt(dx * dx + dy * dy);

      if (distance < params.influenceRadius) {
        const normalizedDist = distance / params.influenceRadius;
        const bumpFactor = Math.max(0, 1 - Math.pow(normalizedDist, 1.5));
        tile.userData.targetZ = bumpFactor * params.maxExtrusion;
      } else {
        tile.userData.targetZ = tile.userData.originalZ;
      }

      const wave =
        Math.sin(tile.position.x * 0.2 + time) *
        Math.cos(tile.position.y * 0.2 + time) *
        params.waveIntensity;

      const targetWithWave = tile.userData.targetZ + wave;
      const diff = targetWithWave - tile.position.z;

      tile.userData.velocityZ += diff * params.springStrength;
      tile.userData.velocityZ *= 0.8;

      tile.position.z += tile.userData.velocityZ;

      const heightDelta = tile.position.z - tile.userData.originalZ;
      const centerDampening = Math.min(
        distance / (params.radius * 1.5),
        1.0
      );

      if (distance > 0.01) {
        const dirX = dx / distance;
        const dirY = dy / distance;

        tile.rotation.x = -dirY * heightDelta * 0.08 * centerDampening;
        tile.rotation.y = dirX * heightDelta * 0.08 * centerDampening;
      } else {
        tile.rotation.x = 0;
        tile.rotation.y = 0;
      }
    }

    if (params.autoColor) {
      const hue = (time * 0.05) % 1;
      floorMaterial.color.setHSL(hue, 1, 0.5);
      floorMaterial.emissive.setHSL(hue, 1, 0.5);
      neonLight.color.setHSL(hue, 1, 0.5);
      neonLight2.color.setHSL((hue + 0.5) % 1, 1, 0.5);
    } else {
      floorMaterial.color.set(params.neonColor);
      floorMaterial.emissive.set(params.neonColor);
      neonLight.color.set(params.neonColor);
      neonLight2.color.set(params.secondaryColor);
    }

    renderer.render(scene, camera);
  }

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight, false);
  });

  animate();
</script>
